{
  "name": "nova-crm",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA CRM — закрытая веб-CRM строительной компании (объекты, задачи, история переходов, отчёты с реплики)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:guards": "eslint src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/rate-limit": "^8.1.1",
    "@supabase/supabase-js": "^2.45.4",
    "fastify": "^4.29.1",
    "pino": "^9.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-local-rules": "file:./eslint-plugin-local-rules",
    "eslint-plugin-react-hooks": "^4.6.2",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
