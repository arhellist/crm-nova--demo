# === MyProjects — общий .gitignore ===
# Копируется в каждый проект перед заливкой на GitHub.

# --- Secrets / env ---
.env
.env.*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
*.secret
secrets/
credentials.json
service-account*.json
.aws/
.gcloud/

# --- Dependencies ---
node_modules/
bower_components/
jspm_packages/
.pnp
.pnp.js
vendor/
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
dist-packages/
Pods/
.bundle/

# --- Build / output ---
dist/
build/
out/
.next/
.nuxt/
.output/
.vercel/
.netlify/
.turbo/
.cache/
*.tsbuildinfo
coverage/
.nyc_output/
*.lcov
storybook-static/
.vite/
tmp/
temp/
*.tmp
*.temp

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS ---
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- IDE / editors ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
.fleet/
.history/
*.code-workspace

# --- Test / tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
.hypothesis/
.playwright/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# --- Mobile ---
*.jks
*.keystore
android/app/build/
ios/build/
ios/Pods/
.expo/
.expo-shared/
*.apk
*.aab
*.ipa

# --- Databases / local data ---
*.sqlite
*.sqlite3
*.db
*.db-journal
dump.sql
*.dump
pgdata/
.redis/
data/local/

# --- Uploads / media (локальные) ---
uploads/
upload/
public/uploads/
storage/
media/uploads/

# --- Docker / local infra ---
docker-compose.override.yml
.docker/

# --- Misc ---
*.bak
*.orig
*.rej
.vibe/
.aider*
!.aider.conf.yml
.cursor/*
!.cursor/rules/
!.cursor/commands/
AGENTS.local.md
.tools/
*.local
!*.local.example

# --- Witness Done: служебные каталоги ---
.sp-cache/
.witness-done-work/

# nested git history backups (do not upload)
.git.nested-bak/
